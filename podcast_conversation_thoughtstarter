# Podcast Delivery Engine - Integration Guide

You have a working podcast pipeline. This adds:
1. **Story tracking** — knows if a headline is appearing for week 2, 3, 4+
2. **Delivery styling** — injects audio tags and varied intros based on that metadata

---

## File 1: `story_tracker.py`

Tracks story continuity across weeks. Persist to JSON or BigQuery.

```python
import json
import hashlib
from datetime import date, timedelta
from pathlib import Path
from typing import Dict, Optional, List
from dataclasses import dataclass, asdict


@dataclass
class StoryRecord:
    story_id: str
    first_seen: str  # ISO date
    last_seen: str   # ISO date
    appearances: List[str]  # List of ISO dates


class StoryTracker:
    def __init__(self, storage_path: Path = Path("data/story_tracking.json")):
        self.storage_path = storage_path
        self.records: Dict[str, StoryRecord] = {}
        if storage_path.exists():
            self._load()
    
    def _load(self):
        with open(self.storage_path) as f:
            data = json.load(f)
        for story_id, rec in data.items():
            self.records[story_id] = StoryRecord(**rec)
    
    def _save(self):
        self.storage_path.parent.mkdir(parents=True, exist_ok=True)
        with open(self.storage_path, "w") as f:
            json.dump({k: asdict(v) for k, v in self.records.items()}, f, indent=2)
    
    def update_and_get_tracking(self, story_id: str, briefing_date: date) -> dict:
        """
        Call this for each story in the briefing.
        Returns tracking info for delivery decisions.
        """
        date_str = briefing_date.isoformat()
        
        if story_id not in self.records:
            # Net new story
            self.records[story_id] = StoryRecord(
                story_id=story_id,
                first_seen=date_str,
                last_seen=date_str,
                appearances=[date_str]
            )
            self._save()
            return {"weeks_continuing": 0, "last_seen_weeks_ago": None}
        
        record = self.records[story_id]
        last_seen = date.fromisoformat(record.last_seen)
        days_since = (briefing_date - last_seen).days
        
        if days_since <= 10:  # Consecutive week
            record.appearances.append(date_str)
            record.last_seen = date_str
            self._save()
            return {"weeks_continuing": len(record.appearances), "last_seen_weeks_ago": 0}
        else:  # Returning after absence
            weeks_ago = days_since // 7
            record.appearances = [date_str]  # Reset
            record.last_seen = date_str
            self._save()
            return {"weeks_continuing": 1, "last_seen_weeks_ago": weeks_ago}
```

