## File 2: `delivery_engine.py`

Rules-based audio tag injection. No LLM, just templates.

```python
import random
from typing import Optional, List


class DeliveryStyleEngine:
    """
    Injects audio tags and selects intro phrases based on story metadata.
    Does NOT modify content - only controls delivery.
    """
    
    # Intros for continuing stories (by week count)
    CONTINUING_INTROS = {
        2: [
            "[thoughtful] This story continues to develop.",
            "[measured] We're tracking this for the second week now.",
            "This remains in focus.",
        ],
        3: [
            "[light chuckle] And here it is again —",
            "[knowing tone] You'll recognize this one —",
            "[wry] Week three on this story:",
            "[amused] Back for round three:",
        ],
        4: [  # 4+ weeks
            "[laughs softly] At this point, it's becoming a saga.",
            "[amused] Our old friend is back:",
            "[dry] I'm starting to think this one has legs:",
            "[knowing] The gift that keeps on giving:",
        ]
    }
    
    NET_NEW_INTROS = [
        "[curious] Here's something new:",
        "[alert] This just hit our radar:",
        "[interested] New development:",
        "First appearance this week:",
    ]
    
    RETURNING_INTROS = {
        2: ["[noting] This is back after a quiet week."],
        3: ["[surprised] This resurfaced after a few weeks off the radar."],
        4: ["[intrigued] This story is back after nearly a month."],
    }
    
    SECTION_TRANSITIONS = {
        "second": ["[pause] Moving on.", "[pause] Next theme.", "Next up."],
        "middle": ["[pause] Continuing.", "Moving along."],
        "final": ["[pause] And finally.", "[pause] Last area to cover."],
    }
    
    OPENINGS = [
        "[warm] Good morning. Here's your weekly intelligence briefing.",
        "[professional] Welcome to this week's executive briefing.",
    ]
    
    CLOSINGS = [
        "[warm] That's your briefing for this week. Stay sharp.",
        "[professional] That wraps this week's intelligence digest.",
        "[warm] Until next week — stay informed.",
    ]
    
    BLUF_INTROS = [
        "[serious] Bottom line up front:",
        "[direct] The key takeaway this week:",
    ]
    
    TREND_TRANSITIONS = [
        "[pause] Zooming out.",
        "[pause] Looking at the bigger picture.",
    ]
    
    def __init__(self, seed: Optional[int] = None, max_reactions: int = 2):
        self.rng = random.Random(seed)
        self.max_reactions = max_reactions
        self.reactions_used = 0
    
    def reset(self):
        """Call at start of each briefing"""
        self.reactions_used = 0
    
    def _pick(self, options: List[str]) -> str:
        return self.rng.choice(options)
    
    def _has_reaction(self, text: str) -> bool:
        return any(r in text.lower() for r in ["laugh", "chuckle", "sigh"])
    
    def get_story_intro(self, weeks_continuing: int, last_seen_weeks_ago: Optional[int]) -> str:
        """Get intro phrase based on story tracking data"""
        
        # Net new
        if weeks_continuing == 0:
            return self._pick(self.NET_NEW_INTROS)
        
        # Returning after absence
        if last_seen_weeks_ago and last_seen_weeks_ago >= 2:
            bucket = min(last_seen_weeks_ago, 4)
            return self._pick(self.RETURNING_INTROS.get(bucket, [""]))
        
        # Continuing story
        if weeks_continuing >= 2:
            bucket = min(weeks_continuing, 4)
            options = self.CONTINUING_INTROS.get(bucket, [""])
            intro = self._pick(options)
            
            # Check reaction budget
            if self._has_reaction(intro):
                if self.reactions_used >= self.max_reactions:
                    # Over budget, pick safe option
                    safe = [o for o in options if not self._has_reaction(o)]
                    intro = self._pick(safe) if safe else ""
                else:
                    self.reactions_used += 1
            return intro
        
        return ""
    
    def get_section_transition(self, index: int, total: int) -> str:
        if index == 0:
            return ""
        elif index == total - 1:
            return self._pick(self.SECTION_TRANSITIONS["final"])
        elif index == 1:
            return self._pick(self.SECTION_TRANSITIONS["second"])
        return self._pick(self.SECTION_TRANSITIONS["middle"])
    
    def get_opening(self) -> str:
        return self._pick(self.OPENINGS)
    
    def get_closing(self) -> str:
        return self._pick(self.CLOSINGS)
    
    def get_bluf_intro(self) -> str:
        return self._pick(self.BLUF_INTROS)
    
    def get_trend_transition(self) -> str:
        return self._pick(self.TREND_TRANSITIONS)
