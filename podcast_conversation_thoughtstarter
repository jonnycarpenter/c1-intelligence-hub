## Integration: Modify Your Dialogue Assembly

Wherever you currently build the `inputs` list for ElevenLabs, wrap it with this:

```python
from datetime import date
from story_tracker import StoryTracker
from delivery_engine import DeliveryStyleEngine


def build_podcast_dialogue(briefing: dict, host_voice: str, analyst_voice: str) -> list:
    """
    Takes your briefing, returns ElevenLabs inputs list with delivery styling.
    """
    tracker = StoryTracker()
    
    # Seed with week number for variety across weeks
    week_num = date.today().isocalendar()[1]
    engine = DeliveryStyleEngine(seed=week_num, max_reactions=2)
    engine.reset()
    
    briefing_date = date.fromisoformat(briefing["week_date"])
    inputs = []
    
    # Opening (host)
    inputs.append({"text": engine.get_opening(), "voice_id": host_voice})
    
    # BLUF (host)
    bluf_intro = engine.get_bluf_intro()
    inputs.append({
        "text": f"{bluf_intro} [short pause] {briefing['bluf']}", 
        "voice_id": host_voice
    })
    
    inputs.append({"text": "[pause] Let's break down the key themes.", "voice_id": host_voice})
    
    # Sections
    sections = briefing["sections"]
    for i, section in enumerate(sections):
        # Get tracking info for this story
        story_id = section["story_id"]
        tracking = tracker.update_and_get_tracking(story_id, briefing_date)
        
        # Section transition (host)
        transition = engine.get_section_transition(i, len(sections))
        if transition:
            inputs.append({"text": transition, "voice_id": host_voice})
        
        # Section header (host)
        inputs.append({"text": f"{section['header']}.", "voice_id": host_voice})
        
        # Headline with delivery intro (analyst)
        intro = engine.get_story_intro(
            weeks_continuing=tracking["weeks_continuing"],
            last_seen_weeks_ago=tracking["last_seen_weeks_ago"]
        )
        headline_text = f"{intro} {section['headline']}" if intro else section["headline"]
        inputs.append({"text": headline_text, "voice_id": analyst_voice})
        
        # Insights (analyst)
        for insight in section.get("insights", []):
            text = insight["text"] if isinstance(insight, dict) else insight
            inputs.append({"text": text, "voice_id": analyst_voice})
    
    # Trend analysis
    inputs.append({"text": engine.get_trend_transition(), "voice_id": host_voice})
    inputs.append({
        "text": f"[thoughtful] {briefing['trend_analysis']}", 
        "voice_id": analyst_voice
    })
    
    # Closing (host)
    inputs.append({"text": engine.get_closing(), "voice_id": host_voice})
    
    return inputs


