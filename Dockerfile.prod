# C1 Intelligence Hub - Production Dockerfile
# Optimized for Cloud Run with GCS volume mount for persistent data
#
# Architecture: FastAPI backend serves API + static frontend files
# Frontend is built as static export and served by FastAPI's StaticFiles

# Stage 1: Build Frontend (Static Export)
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# Copy package files
COPY frontend/package*.json ./

# Install ALL dependencies (need devDependencies for build)
RUN npm ci

# Copy source files
COPY frontend/ ./

# Build as static export for FastAPI to serve
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Update next.config.js to use static export
RUN printf '%s\n' \
    '/** @type {import("next").NextConfig} */' \
    'const nextConfig = {' \
    '  output: "export",' \
    '  trailingSlash: true,' \
    '  images: { unoptimized: true },' \
    '}' \
    'module.exports = nextConfig' \
    > next.config.js && cat next.config.js

# Build static export
RUN npm run build

# Stage 2: Production Python Backend + Static Frontend
FROM python:3.11-slim AS production

WORKDIR /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Copy Python requirements and install
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip cache purge

# Copy backend application
COPY backend/ ./

# Copy static frontend from builder stage
# This goes to frontend/out which FastAPI's main.py mounts as static files
COPY --from=frontend-builder /app/frontend/out ./frontend/out

# Create necessary directories
# Note: /app/data will be mounted from GCS at runtime
RUN mkdir -p /app/logs /app/downloads /app/data

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Set ownership
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8080
ENV ENVIRONMENT=production

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# Expose port (Cloud Run uses PORT env var)
EXPOSE 8080

# Start the application
ENTRYPOINT ["/docker-entrypoint.sh"]
