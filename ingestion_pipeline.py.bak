@dataclass
class IngestionConfig:
    """Configuration for the ingestion pipeline"""
    
    # API Keys (from environment)
    anthropic_api_key: str = field(default_factory=lambda: os.getenv("ANTHROPIC_API_KEY", ""))
    fmp_api_key: str = field(default_factory=lambda: os.getenv("FMP_API_KEY", ""))
    tavily_api_key: str = field(default_factory=lambda: os.getenv("TAVILY_API_KEY", ""))
    
    # Database
    db_type: str = field(default_factory=lambda: os.getenv("DB_TYPE", "sqlite"))
    sqlite_path: str = field(default_factory=lambda: os.getenv("SQLITE_PATH", "c1_hub.db"))
    
    # Vector Store
    chroma_persist_dir: str = field(default_factory=lambda: os.getenv("CHROMA_PERSIST_DIR", "./chroma_db"))
    embedding_model: str = "text-embedding-3-small"  # OpenAI or use Claude
    
    # Ingestion Settings
    rss_poll_interval_hours: int = 2
    fmp_poll_interval_hours: int = 4
    max_articles_per_feed: int = 20
    max_article_age_days: int = 7
    
    # Classification
    classifier_model: str = "claude-sonnet-4-20250514"
    classifier_temperature: float = 0.1
    
    # Digest
    digest_hours: int = 72
    digest_max_items: int = 50
    digest_model: str = "claude-sonnet-4-20250514"


